{
    "compilerOptions": {
        "lib": ["DOM", "ESNext"],
        "types": [],
        "strict": true,
        "noEmit": true,
        "module": "ESNext",
        "moduleResolution": "bundler",
        "verbatimModuleSyntax": true,
        "skipLibCheck": true,
        // The core's client library (step engine, fit, patches, ink, the
        // socket) as frontends built on inkflow import it: inkflow-editor's
        // TypeScript says `@inkflow/shared/step`, never a path into the core.
        "paths": {
            "@inkflow/shared/*": ["./src/ts/shared/*"]
        }
    },
    "include": ["src/ts/**/*", "inkflow-editor/src/ts/**/*"]
}
